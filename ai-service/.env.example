# AI Mode: 'demo' | 'production'
# demo: Uses controlled sample responses (no API costs)
# production: Uses real AI models and APIs
AI_MODE=demo

# Vision Provider: 'local' | 'openai' | 'anthropic' | 'demo' | 'gemini'
VISION_PROVIDER=demo

# LLM Provider: 'openai' | 'anthropic' | 'demo' | 'gemini'
LLM_PROVIDER=demo

# OpenAI (required if VISION_PROVIDER=openai or LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic (required if VISION_PROVIDER=anthropic or LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096

# Google Gemini (required if VISION_PROVIDER=gemini or LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_CHAT_MODEL=gemini-1.5-flash

# USDA FoodData Central API (optional, enhances nutrition accuracy)
# Get free key: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=

# Server
PORT=8000
HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Model cache directory (for HuggingFace models)
HF_HOME=/tmp/hf_cache
